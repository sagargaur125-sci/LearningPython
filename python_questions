        "import math\n",
        "def taylor_expansion_sine(x, terms=10):\n",
        "    x = math.radians(x)\n",
        "    result=[]\n",
        "    fresult=0\n",
        "    for n in range(terms):\n",
        "        term = ((-1) ** n) * (x ** (2 * n + 1)) / math.factorial(2 * n + 1)\n",
        "        result.append(term)\n",
        "        fresult+=term\n",
        "    return result,fresult\n",
        "\n",
        "x,y=taylor_expansion_sine(60)\n",
